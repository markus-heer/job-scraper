# Job_Tool environment file template (Requirement 1.12).
#
# Copy this file to `.env` and fill in real values. `.env` is excluded from version
# control; this template must never contain a real secret.
# Every key the API_Service reads is required: if one is missing or empty, the
# Start_Script and the API_Service stop before serving a request and name the missing
# keys (1.15). Two keys are exceptions, and each says below what it is for:
# `POSTGRES_PORT`, which docker-compose.yml reads and the API_Service never does, and
# `SCRAPER_FIXTURE_MODE`, which the API_Service reads but does not require.

# --- Posting_Store -----------------------------------------------------------------
# PostgreSQL connection string. Host, port and credentials must match docker-compose.yml.
# Port 55432 rather than the PostgreSQL default 5432: on a development machine 5432 is
# regularly taken by another PostgreSQL, and the Job_Tool container must not compete
# for it.
DATABASE_URL=postgresql://jobtool:change-me@127.0.0.1:55432/jobtool?schema=public
# Host port docker-compose.yml binds the container to. Must name the same port as
# `DATABASE_URL` above, which stays the single source of truth for the connection: the
# Start_Script derives this value from `DATABASE_URL` and hands it to Compose, and the
# key is written out here so that a plain `docker compose up -d` binds the same port.
POSTGRES_PORT=55432

# --- Commute_Service ---------------------------------------------------------------
# Starting address of every commute determination. Non-empty.
HOME_ADDRESS=Hörkherstraße 1d, 80689 München
# Commute_Threshold in minutes. Integer from 5 to 240.
COMMUTE_THRESHOLD_MINUTES=60
# Routing_Provider implementation: `heigit` (default, no billing relationship) or `google`.
ROUTING_PROVIDER=heigit
# API key of the selected Routing_Provider.
ROUTING_API_KEY=your-routing-provider-api-key

# --- Relevance_Service / AI_Provider ----------------------------------------------
# Anthropic API key used for relevance assessment and work location normalization.
ANTHROPIC_API_KEY=sk-ant-your-api-key
# Model name stored per assessment, so a later model change stays visible in the data.
ANTHROPIC_MODEL=claude-sonnet-4-5
# Master switch for the relevance assessment: `true` or `false`.
# When `false`, every Job_Posting keeps the Relevance_Verdict "not assessed".
RELEVANCE_ENABLED=true
# Parallel AI_Provider requests. Integer, default 4.
RELEVANCE_CONCURRENCY=4
# Maximum assessments per Scrape_Run. Integer, 1 to 20000, default 2000.
# Each assessment is one paid AI_Provider request, so this is the main cost lever of a Scrape_Run.
# Since the retrieval reads each result list to its end (13.3) a run can yield several thousand
# Job_Posting; the content hash gate means only new or changed ones are assessed, so the first run
# after a change is the expensive one. The Log_Stream reports how many postings the cap skipped, and
# the next run takes those first.
RELEVANCE_MAX_PER_RUN=2000

# --- Scrape_Run enrichment ---------------------------------------------------------
# Grace period in minutes after the retrieval phase in which commute and relevance
# enrichment may still finish. Integer, default 10.
ENRICHMENT_GRACE_MINUTES=10

# --- Platform etiquette ------------------------------------------------------------
# Contact detail carried in the Job_Tool user agent of every Platform request (14.5).
USER_AGENT_CONTACT=your.name@example.com

# --- Local ports (bound to 127.0.0.1 only) -----------------------------------------
# Port of the API_Service.
API_PORT=4000
# Port at which the Web_App is served.
WEB_PORT=5173

# --- E2E test harness (leave empty for normal operation) ---------------------------
# The only key the API_Service reads without requiring it. Empty or unset means normal
# operation; `1` or `true` switches the Job_Tool onto fixtures, which the Playwright
# suite does for itself and which nobody should set here.
#
# In fixture mode the Platform_Adapter read the frozen pages under
# `packages/scrapers/src/adapters/<platform>/__fixtures__/` instead of querying a
# Platform, the Routing_Provider and the AI_Provider are local doubles, every request
# to anything but 127.0.0.1 is refused, and the API_Service refuses to start unless
# `DATABASE_URL` names a database whose name ends in `_test`. The retrieval, the
# Posting_Store writes and the Log_Stream are the real ones — so a Job_Posting stored
# in this mode came from a fixture and a Best_Commute_Time was derived rather than
# measured. Running it against the normal Posting_Store would mix invented data into
# real data, which is why the `_test` rule exists.
#
# `pnpm test:e2e` sets this itself in the API_Service process it starts
# (`apps/web/e2e/harness/start-api.mjs`), so there is no reason to set it here.
SCRAPER_FIXTURE_MODE=
