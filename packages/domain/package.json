{
  "name": "@job-scraper/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Closed value lists, search criteria types and pure domain helpers shared by every workspace package",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./enums": {
      "types": "./dist/enums.d.ts",
      "default": "./dist/enums.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --fix",
    "test": "vitest"
  },
  "devDependencies": {
    "@job-scraper/eslint-config": "workspace:*",
    "@job-scraper/typescript-config": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "fast-check": "4.10.2"
  }
}
