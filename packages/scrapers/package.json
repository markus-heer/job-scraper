    "@job-scraper/typescript-config": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@job-scraper/domain": "workspace:*",
    "node-html-parser": "9.0.5",
    "playwright": "1.64.1",
    "robots-parser": "3.0.1"
  }
}
