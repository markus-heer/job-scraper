{
  "name": "@job-scraper/scrapers",
  "version": "0.1.0",
  "private": true,
  "description": "Scheduling and etiquette primitives, Platform_Adapter implementations and the Playwright runtime of the Scraper_Service",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
